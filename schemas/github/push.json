{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "github/push",
  "title": "GitHub Push Event",
  "description": "Schema for GitHub push webhook events",
  "type": "object",
  "required": ["ref", "repository"],
  "properties": {
    "ref": {
      "type": "string",
      "pattern": "^refs/(heads|tags)/",
      "description": "Git ref that was pushed (e.g., refs/heads/main)"
    },
    "before": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "SHA of the previous HEAD commit"
    },
    "after": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "SHA of the new HEAD commit"
    },
    "repository": {
      "type": "object",
      "required": ["id", "name", "full_name"],
      "properties": {
        "id": {
          "type": "integer",
          "description": "Repository ID"
        },
        "name": {
          "type": "string",
          "description": "Repository name"
        },
        "full_name": {
          "type": "string",
          "description": "Full repository name (owner/repo)"
        },
        "private": {
          "type": "boolean",
          "description": "Whether the repository is private"
        }
      }
    },
    "pusher": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      }
    },
    "sender": {
      "type": "object",
      "properties": {
        "login": {
          "type": "string"
        },
        "id": {
          "type": "integer"
        }
      }
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "message"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "message": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "author": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "email": {"type": "string", "format": "email"}
            }
          }
        }
      }
    },
    "head_commit": {
      "type": ["object", "null"],
      "properties": {
        "id": {"type": "string"},
        "message": {"type": "string"}
      }
    }
  }
}
